# Copy to .env (git-ignored) and adjust. Every variable maps 1:1 to a field in
# src/riverbend/config.py. On GCP these come from Cloud Run env vars + Secret Manager.

# --- database ---------------------------------------------------------------
# Runtime connection: the NON-superuser role, so row-level security applies.
DATABASE_URL=postgresql://riverbend_app:riverbend_app@127.0.0.1:5433/riverbend
# Owner/admin connection: migrations, seeding, eval harness only.
DATABASE_ADMIN_URL=postgresql://postgres@127.0.0.1:5433/riverbend
APP_DB_PASSWORD=riverbend_app

# --- model provider -------------------------------------------------------------
# offline   = hand-written stand-in outputs, no network, $0 (default)
# anthropic = Claude via the Anthropic API (needs ANTHROPIC_API_KEY)
# vertex    = Claude on Google Vertex AI (uses the service account; no API key)
LLM_PROVIDER=offline
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
# ANTHROPIC_API_KEY=sk-ant-...        # never commit this
# VERTEX_PROJECT=my-gcp-project
# VERTEX_REGION=global

# Fault injection for demos: flaky:0.3 | garbage:0.2 | outage | outage:10 | slow:2.0 (comma-separated)
LLM_FAULTS=

# --- policy -----------------------------------------------------------------------
DEFAULT_MONTHLY_CAP_USD=5.00
MAX_ATTEMPTS=6
RETRY_BASE_SECONDS=20
PROCESSING_SLA_SECONDS=900

# --- auth (dev values; production values live in Secret Manager) ---------------------
INGEST_KEYS={"dev-ingest-key": ["rb-downtown", "rb-northside", "rb-lakeshore"]}
STAFF_TOKENS={"dev-downtown-token": "rb-downtown", "dev-northside-token": "rb-northside", "dev-lakeshore-token": "rb-lakeshore"}
ADMIN_TOKEN=dev-admin-token
DEV_MODE=true
